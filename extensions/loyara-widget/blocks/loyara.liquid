{% comment %}
  Loyara loyalty widget — app embed block (target: body). A floating launcher that
  opens a panel with the member's points, VIP status, progress to the next reward,
  ways to earn, redeemable rewards (with one-tap checkout apply), referral sharing
  and birthday capture. All data is signed via the App Proxy (/apps/loyalty/*).

  SKIN (2026-09): the panel/launcher are reskinned to the "minimal-mono" house
  style. EVERY colour is routed through ONE merchant accent: bg_color → --ly-accent
  (fills, buttons, progress, focus ring), text_color → --ly-on-accent (ink on those
  fills). Neutral surface/ink/line greys are fixed tokens (not brand colours) so the
  panel stays legible whatever accent the merchant picks — no hardcoded gold or blue.
  Every accent-derived colour-mix has a neutral rgba fallback declared BEFORE it, so
  browsers without color-mix still render sanely.

  PRESET (block.settings.preset): "mono" (default, l01), "drawer" (l07 native
  side-drawer), "hero" (l02 reward-hero). Each is a CSS class on the launcher +
  panel root; the JS state/render functions and the /apps/loyalty/* endpoints are
  UNCHANGED. Two CSS-only limits are noted inline: the drawer has no scrim/focus-trap
  (the ESC + outside-click close still work) and the hero renders a prominent linear
  progress bar rather than the l02 SVG ring (the ring needs JS to compute its
  stroke-dashoffset, which we must not touch here).
{% endcomment %}
{% if block.settings.enable %}
  {%- assign preset = block.settings.preset | default: 'mono' -%}
  <style>
    /* ---- tokens: one merchant accent + fixed neutral surface palette ---- */
    #loyara-launcher, #loyara-panel {
      --ly-accent: {{ block.settings.bg_color | default: '#1a1a1a' }};
      --ly-on-accent: {{ block.settings.text_color | default: '#ffffff' }};
      --ly-surface: #ffffff;
      --ly-ink: #1a1a1a;
      --ly-ink-2: #6b6b6b;
      --ly-line: #ececec;
      --ly-card: #fafafa;
      --ly-lock: #b3b3b3;
      --ly-ok: #2a7d5f;
      /* accent-tinted surfaces — neutral rgba fallback first, then color-mix */
      --ly-accent-tint: rgba(0,0,0,.05);
      --ly-accent-tint: color-mix(in srgb, var(--ly-accent) 10%, var(--ly-surface));
      --ly-accent-line: rgba(0,0,0,.14);
      --ly-accent-line: color-mix(in srgb, var(--ly-accent) 24%, var(--ly-surface));
    }

    /* ---------------- launcher (pill) ---------------- */
    #loyara-launcher {
      position: fixed; z-index: 2147483000;
      bottom: {{ block.settings.offset }}px; {{ block.settings.side }}: 20px;
      display: inline-flex; align-items: center; gap: 9px;
      min-height: 44px; padding: 0 18px; border: none; border-radius: 999px; cursor: pointer;
      font-family: inherit; font-weight: 600; font-size: 14px; line-height: 1;
      font-variant-numeric: tabular-nums; letter-spacing: .01em;
      background: var(--ly-accent, #1a1a1a); color: var(--ly-on-accent, #fff);
      box-shadow: 0 2px 6px rgba(0,0,0,.14), 0 8px 24px rgba(0,0,0,.10);
      -webkit-font-smoothing: antialiased;
      transition: transform .12s ease, box-shadow .12s ease;
    }
    #loyara-launcher:hover { transform: translateY(-1px); box-shadow: 0 4px 10px rgba(0,0,0,.18), 0 12px 30px rgba(0,0,0,.12); }
    #loyara-launcher:active { transform: translateY(0); }
    #loyara-launcher:focus-visible { outline: 3px solid var(--ly-accent, #1a1a1a); outline-offset: 3px; }
    #loyara-launcher .ly-mark { width: 16px; height: 16px; flex: 0 0 auto; display: block; }
    #loyara-badge { font-weight: 700; font-variant-numeric: tabular-nums; }

    /* ---------------- panel (shared shell) ---------------- */
    #loyara-panel {
      position: fixed; z-index: 2147483001; display: none;
      bottom: {{ block.settings.offset | plus: 60 }}px; {{ block.settings.side }}: 20px;
      width: 360px; max-width: calc(100vw - 40px); max-height: min(78vh, 640px);
      overflow-y: auto; -webkit-overflow-scrolling: touch;
      background: var(--ly-surface); color: var(--ly-ink);
      border: 1px solid var(--ly-line); border-radius: 18px;
      box-shadow: 0 8px 24px rgba(0,0,0,.12), 0 24px 60px rgba(0,0,0,.16);
      font-family: inherit; font-size: 14px; line-height: 1.5;
      font-variant-numeric: tabular-nums; -webkit-font-smoothing: antialiased;
    }
    #loyara-panel.open { display: block; }
    #loyara-panel * { box-sizing: border-box; }

    /* header (JS-built: .loyara-head > .bal + .vip + .loyara-prog) */
    .loyara-head { padding: 18px 16px 16px; background: var(--ly-surface); color: var(--ly-ink); border-bottom: 1px solid var(--ly-line); }
    .loyara-head .bal { font-size: 30px; font-weight: 700; line-height: 1; letter-spacing: -.01em; display: block; }
    .loyara-head .vip { display: inline-block; margin-top: 8px; padding: 4px 9px; border-radius: 999px; background: transparent; border: 1px solid var(--ly-line); color: var(--ly-ink); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .loyara-prog { margin-top: 14px; }
    .loyara-prog .track { height: 6px; background: var(--ly-line); border-radius: 999px; overflow: hidden; }
    .loyara-prog .fill { height: 6px; background: var(--ly-accent, #1a1a1a); border-radius: 999px; }
    .loyara-prog small { display: block; margin-top: 7px; color: var(--ly-ink-2); font-size: 12px; opacity: 1; }

    /* sections */
    .loyara-sec { padding: 16px; border-bottom: 1px solid var(--ly-line); }
    .loyara-sec:last-child { border-bottom: none; }
    .loyara-sec h4 { margin: 0 0 12px; font-size: 12px; text-transform: uppercase; letter-spacing: .1em; color: var(--ly-ink-2); font-weight: 700; }

    /* ways to earn */
    .loyara-earn { display: flex; align-items: center; gap: 9px; padding: 4px 0; color: var(--ly-ink-2); font-size: 13.5px; }
    .loyara-earn b { color: var(--ly-ink); font-weight: 700; }

    /* redeem cards (JS-built .loyara-tier) */
    .loyara-tier { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; margin-top: 8px; border: 1px solid var(--ly-line); border-radius: 12px; background: var(--ly-card); }
    .loyara-tier:first-of-type { margin-top: 0; }
    .loyara-tier + .loyara-tier { border-top: 1px solid var(--ly-line); }
    .loyara-tier small { color: var(--ly-ink-2); }

    /* buttons — filled with the accent */
    .loyara-btn { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 7px 15px; border: none; border-radius: 9px; cursor: pointer; background: var(--ly-accent, #1a1a1a); color: var(--ly-on-accent, #fff); font-weight: 600; font-size: 13px; font-family: inherit; }
    .loyara-btn:hover { filter: brightness(1.08); }
    .loyara-btn:focus-visible { outline: 2px solid var(--ly-accent, #1a1a1a); outline-offset: 2px; }
    .loyara-btn:disabled { background: transparent; color: var(--ly-lock); border: 1px solid var(--ly-line); cursor: default; filter: none; }
    .loyara-btn.sec { background: transparent; color: var(--ly-ink); border: 1px solid var(--ly-ink); }
    .loyara-btn.sec:hover { background: var(--ly-card); filter: none; }

    .loyara-msg { color: var(--ly-ink-2); padding: 4px 0; }
    .loyara-code { margin-top: 10px; padding: 10px; background: var(--ly-card); border: 1px solid var(--ly-line); border-radius: 8px; font-family: monospace; text-align: center; font-size: 15px; letter-spacing: .05em; color: var(--ly-ink); }
    .loyara-actions { display: flex; gap: 8px; margin-top: 10px; }
    .loyara-actions a, .loyara-actions button { flex: 1; min-height: 44px; display: flex; align-items: center; justify-content: center; text-align: center; text-decoration: none; }
    .loyara-actions a { padding: 8px; border-radius: 9px; background: var(--ly-accent, #1a1a1a); color: var(--ly-on-accent, #fff); font-weight: 600; font-size: 13px; }
    .loyara-actions a:focus-visible { outline: 2px solid var(--ly-accent, #1a1a1a); outline-offset: 2px; }
    .loyara-row { display: flex; gap: 6px; margin-top: 8px; }
    .loyara-row input, .loyara-row select { flex: 1; min-height: 44px; padding: 8px; border: 1px solid var(--ly-line); border-radius: 9px; font: inherit; background: var(--ly-surface); color: var(--ly-ink); }
    .loyara-row input:focus-visible, .loyara-row select:focus-visible { outline: 2px solid var(--ly-accent, #1a1a1a); outline-offset: 1px; }

    .loyara-close { position: absolute; top: 10px; {{ block.settings.side }}: 10px; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; border-radius: 10px; color: var(--ly-ink-2); font-size: 22px; cursor: pointer; line-height: 1; }
    .loyara-close:hover { background: var(--ly-card); color: var(--ly-ink); }
    .loyara-close:focus-visible { outline: 2px solid var(--ly-accent, #1a1a1a); outline-offset: 2px; }

    .loyara-foot { padding: 11px 16px 14px; font-size: 10px; letter-spacing: .05em; text-transform: uppercase; color: var(--ly-ink-2); text-align: center; }
    .loyara-foot a { color: var(--ly-ink-2); }

    /* ===================== PRESET: drawer (l07) =====================
       CSS-only side drawer. The JS still just toggles `.open`; we keep the
       element in the DOM (display:block) and slide it with a transform +
       visibility so the existing open/close hook animates. NOTE (CSS-only
       limit): there is no scrim and no focus-trap here — those would require
       changing the JS; the ESC key and outside-click close (already wired)
       remain the way to dismiss it. */
    #loyara-panel.ly-drawer {
      display: block; top: 0; bottom: 0; {{ block.settings.side }}: 0;
      height: 100dvh; height: 100vh; width: min(400px, calc(100vw - 40px));
      max-width: none; max-height: none; border-radius: 0;
      border: none; border-{% if block.settings.side == 'left' %}right{% else %}left{% endif %}: 1px solid var(--ly-line);
      visibility: hidden;
      transform: translateX({% if block.settings.side == 'left' %}-105%{% else %}105%{% endif %});
      transition: transform .32s cubic-bezier(.22,.61,.36,1), visibility .32s;
    }
    #loyara-panel.ly-drawer.open { visibility: visible; transform: translateX(0); }
    #loyara-panel.ly-drawer .loyara-head { background: var(--ly-accent-tint); padding-top: 22px; }

    /* ===================== PRESET: hero (l02) =====================
       Outcome-first header: big balance on a warm accent-tinted card with a
       prominent progress bar. NOTE (CSS-only limit): the l02 circular progress
       RING is not reproduced — the JS builds a linear .loyara-prog track and
       computing an SVG ring's stroke-dashoffset would require touching the JS,
       which is out of scope here. We render the linear bar, enlarged, instead. */
    #loyara-panel.ly-hero .loyara-head {
      background: var(--ly-accent-tint);
      border-bottom: 1px solid var(--ly-accent-line);
      padding: 22px 16px 20px;
    }
    #loyara-panel.ly-hero .loyara-head .bal { font-size: 38px; letter-spacing: -.02em; }
    #loyara-panel.ly-hero .loyara-head .vip { border-color: var(--ly-accent-line); }
    #loyara-panel.ly-hero .loyara-prog .track { height: 9px; }
    #loyara-panel.ly-hero .loyara-prog .fill { height: 9px; }
    #loyara-panel.ly-hero .loyara-tier { background: var(--ly-surface); }

    /* dark storefronts: soften neutral surfaces, keep the merchant accent */
    @media (prefers-color-scheme: dark) {
      #loyara-launcher, #loyara-panel {
        --ly-surface: #161616; --ly-ink: #f2f2f2; --ly-ink-2: #a3a3a3;
        --ly-line: #2b2b2b; --ly-card: #1f1f1f; --ly-lock: #6f6f6f; --ly-ok: #4bbd93;
        --ly-accent-tint: rgba(255,255,255,.06);
        --ly-accent-tint: color-mix(in srgb, var(--ly-accent) 22%, #161616);
        --ly-accent-line: rgba(255,255,255,.14);
        --ly-accent-line: color-mix(in srgb, var(--ly-accent) 34%, #161616);
      }
      #loyara-launcher { box-shadow: 0 2px 6px rgba(0,0,0,.5), 0 10px 30px rgba(0,0,0,.4); }
      #loyara-panel { box-shadow: 0 8px 24px rgba(0,0,0,.5), 0 24px 60px rgba(0,0,0,.6); }
    }

    @media (prefers-reduced-motion: reduce) {
      #loyara-launcher, #loyara-panel.ly-drawer { transition: none; }
    }
  </style>

  <button id="loyara-launcher" class="ly-{{ preset }}" aria-haspopup="dialog" aria-expanded="false" aria-controls="loyara-panel">
    <svg class="ly-mark" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 1.6l1.7 3.9 4.2.4-3.2 2.8 1 4.1L8 10.6 4.3 12.8l1-4.1L2.1 5.9l4.2-.4L8 1.6z" fill="currentColor"/>
    </svg>
    <span>{{ block.settings.label | escape }}</span>
    <span id="loyara-badge"></span>
  </button>

  <div id="loyara-panel" class="ly-{{ preset }}" role="dialog" aria-modal="false" aria-label="{{ block.settings.label | escape }}">
    <button class="loyara-close" id="loyara-close" aria-label="Close">×</button>
    <div id="loyara-content"><div class="loyara-sec"><div class="loyara-msg">Loading…</div></div></div>
    <div class="loyara-foot" id="loyara-foot"></div>
  </div>

  <script>
    (function () {
      function init() {
      var launcher = document.getElementById("loyara-launcher");
      var panel = document.getElementById("loyara-panel");
      var content = document.getElementById("loyara-content");
      var badge = document.getElementById("loyara-badge");
      var footEl = document.getElementById("loyara-foot");
      var closeBtn = document.getElementById("loyara-close");
      var loginUrl = {{ routes.account_login_url | json }};
      var state = null, loaded = false;

      function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"})[c];}); }
      function n(v){ return new Intl.NumberFormat().format(v); }
      function money(v){ try { return new Intl.NumberFormat(undefined,{style:"currency",currency:(state&&state.currency)||"USD"}).format(v);}catch(e){return v+" "+((state&&state.currency)||"");} }
      function rewardLabel(t){
        // Fixed tiers become store credit when the shop delivers rewards that way.
        if (state && state.redemptionMode === "store_credit" && t.type !== "percent") return money(t.value)+" store credit";
        return t.type==="percent" ? (t.value+"% off") : (money(t.value)+" off");
      }
      function uuid(){ if(window.crypto&&crypto.getRandomValues){var a=new Uint8Array(16);crypto.getRandomValues(a);return Array.prototype.map.call(a,function(b){return("0"+b.toString(16)).slice(-2);}).join("");} return Date.now().toString(36)+Math.random().toString(36).slice(2,10); }

      function waysToEarn(){
        var e = state.earn, items = [];
        if (e.pointsPerDollar>0) items.push("Earn <b>"+n(e.pointsPerDollar)+"</b> point"+(e.pointsPerDollar===1?"":"s")+" per "+money(1)+" spent");
        if (e.signupBonus>0) items.push("<b>"+n(e.signupBonus)+"</b> points for signing up");
        if (e.birthdayBonus>0) items.push("<b>"+n(e.birthdayBonus)+"</b> points on your birthday");
        if (state.referralEnabled) items.push("<b>"+n(e.referralReward)+"</b> points for each friend you refer");
        if (!items.length) return "";
        return '<div class="loyara-sec"><h4>Ways to earn</h4>'+items.map(function(t){return '<div class="loyara-earn">'+t+'</div>';}).join("")+'</div>';
      }

      function renderLoggedOut(){
        var e = state.earn, sell = e.signupBonus>0 ? ("Join and get <b>"+n(e.signupBonus)+"</b> points to start.") : "Join to start earning points on every order.";
        badge.textContent = "";
        content.innerHTML = '<div class="loyara-head"><span class="bal">Rewards</span></div>'
          + '<div class="loyara-sec"><div class="loyara-msg">'+sell+'</div>'
          + (loginUrl ? '<div class="loyara-actions"><a href="'+loginUrl+'">Log in / Sign up</a></div>' : '')
          + '</div>' + waysToEarn();
      }

      function progressBar(){
        if (!state.nextReward) return "";
        var nr = state.nextReward, tot = nr.points, done = tot - nr.remaining, pct = Math.max(0, Math.min(100, Math.round(done/tot*100)));
        return '<div class="loyara-prog"><div class="track"><div class="fill" style="width:'+pct+'%"></div></div>'
          + '<small>'+n(nr.remaining)+' pts to your next reward</small></div>';
      }

      function renderLoggedIn(){
        badge.textContent = "· " + n(state.balance);
        var vipLine = state.vip && state.vip.current ? '<span class="vip">'+esc(state.vip.current)+'</span>' : (state.vip && state.vip.next ? '<span class="vip">'+n(state.vip.toNext)+' pts to '+esc(state.vip.next.name)+'</span>' : '');
        var html = '<div class="loyara-head"><span class="bal">'+n(state.balance)+' pts</span>'+vipLine+progressBar()+'</div>';

        // Rewards
        html += '<div class="loyara-sec"><h4>Redeem</h4>';
        if (!state.tiers.length) html += '<div class="loyara-msg">No rewards available yet.</div>';
        else state.tiers.forEach(function(t,i){
          var can = state.balance >= t.points;
          html += '<div class="loyara-tier"><span>'+esc(rewardLabel(t))+'<br><small style="color:#888">'+n(t.points)+' pts</small></span>'
            + '<button class="loyara-btn" data-redeem="'+i+'"'+(can?"":" disabled")+'>Redeem</button></div>';
        });
        html += '<div id="loyara-redeem-out"></div></div>';

        html += waysToEarn();

        // Referral
        if (state.referralEnabled) html += '<div class="loyara-sec"><h4>Refer a friend</h4>'
          + '<div class="loyara-msg">Share your code — friends get a discount, you earn points when they order.</div>'
          + '<div class="loyara-actions"><button class="loyara-btn" id="loyara-refer">Get my referral code</button></div>'
          + '<div id="loyara-refer-out"></div></div>';

        // Birthday
        if (state.earn.birthdayBonus>0 && !state.birthdayKnown) html += '<div class="loyara-sec"><h4>Get a birthday bonus</h4>'
          + '<div class="loyara-row"><select id="loyara-bmonth"></select><select id="loyara-bday"></select>'
          + '<button class="loyara-btn" id="loyara-bsave">Save</button></div><div id="loyara-b-out"></div></div>';

        content.innerHTML = html;
        wire();
      }

      function render(){
        if (!state) return;
        footEl.innerHTML = state.branded ? 'Powered by <a href="https://apps.shopify.com/loyara" target="_blank" rel="noopener">Loyara</a>' : "";
        if (!state.active){ content.innerHTML = '<div class="loyara-sec"><div class="loyara-msg">The rewards program is currently paused.</div></div>'; return; }
        if (!state.loggedIn) renderLoggedOut(); else renderLoggedIn();
      }

      function wire(){
        content.querySelectorAll("button[data-redeem]").forEach(function(b){ b.addEventListener("click",function(){ redeem(parseInt(b.getAttribute("data-redeem"),10), b); }); });
        var refer = document.getElementById("loyara-refer"); if (refer) refer.addEventListener("click", getReferral);
        var bsave = document.getElementById("loyara-bsave"); if (bsave){ fillBirthday(); bsave.addEventListener("click", saveBirthday); }
      }

      function applyLink(code){ return '<div class="loyara-actions"><a href="/discount/'+encodeURIComponent(code)+'">Apply at checkout</a><button class="loyara-btn sec" data-copy="'+esc(code)+'">Copy code</button></div>'; }
      function bindCopy(scope){ scope.querySelectorAll("button[data-copy]").forEach(function(b){ b.addEventListener("click",function(){ var c=b.getAttribute("data-copy"); if(navigator.clipboard) navigator.clipboard.writeText(c); b.textContent="Copied!"; }); }); }

      function redeem(i, btn){
        if (!btn.dataset.key) btn.dataset.key = uuid();
        btn.disabled = true; btn.textContent = "…";
        fetch("/apps/loyalty/redeem",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({tierIndex:i,idempotencyKey:btn.dataset.key})})
          .then(function(r){return r.json();})
          .then(function(d){
            var out = document.getElementById("loyara-redeem-out");
            if (d && d.ok){
              if (d.mode === "store_credit" || d.credited != null){
                out.innerHTML = '<div class="loyara-msg">'+money(d.credited)+' store credit added to your account.<br><small style="color:#888">It applies automatically at checkout.</small></div>';
              } else {
                out.innerHTML = '<div class="loyara-code">'+esc(d.code)+'</div>'+applyLink(d.code); bindCopy(out);
              }
              // Update balance IN PLACE — never rebuild the panel here (that would wipe the output above).
              if (state) state.balance = Math.max(0, state.balance - (d.cost||0));
              var balEl = content.querySelector('.bal'); if (balEl) balEl.textContent = n(state.balance)+' pts';
              if (badge) badge.textContent = '· '+n(state.balance);
              content.querySelectorAll('button[data-redeem]').forEach(function(b){
                var t = state && state.tiers[parseInt(b.getAttribute('data-redeem'),10)];
                delete b.dataset.key; b.textContent='Redeem'; b.disabled = !(t && state.balance >= t.points);
              });
            }
            else { btn.disabled=false; btn.textContent="Redeem"; delete btn.dataset.key; out.innerHTML='<div class="loyara-msg">'+(d&&d.error==="insufficient"?"Not enough points yet.":"That didn’t work—please try again.")+'</div>'; }
          })
          .catch(function(){ btn.disabled=false; btn.textContent="Redeem"; });
      }

      function getReferral(){
        var btn = document.getElementById("loyara-refer"); btn.disabled=true; btn.textContent="…";
        fetch("/apps/loyalty/referral",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:"{}"})
          .then(function(r){return r.json();})
          .then(function(d){
            var out = document.getElementById("loyara-refer-out");
            if (d && d.ok){ var share = location.origin+'/discount/'+encodeURIComponent(d.code); out.innerHTML = '<div class="loyara-msg">Friends get '+money(d.friendDiscount)+' off. You earn '+n(d.reward)+' points per order.</div><div class="loyara-code">'+esc(d.code)+'</div><div class="loyara-actions"><button class="loyara-btn sec" data-copy="'+esc(share)+'">Copy share link</button></div>'; bindCopy(out); btn.style.display="none"; }
            else { btn.disabled=false; btn.textContent="Get my referral code"; out.innerHTML='<div class="loyara-msg">Referrals aren’t available right now.</div>'; }
          })
          .catch(function(){ btn.disabled=false; btn.textContent="Get my referral code"; });
      }

      function fillBirthday(){
        var m=document.getElementById("loyara-bmonth"), day=document.getElementById("loyara-bday");
        var mn=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
        m.innerHTML = mn.map(function(x,i){return '<option value="'+(i+1)+'">'+x+'</option>';}).join("");
        var ds=""; for(var i=1;i<=31;i++) ds+='<option value="'+i+'">'+i+'</option>'; day.innerHTML=ds;
      }
      function saveBirthday(){
        var m=document.getElementById("loyara-bmonth").value, d=document.getElementById("loyara-bday").value;
        var mm=("0"+m).slice(-2), dd=("0"+d).slice(-2);
        var btn=document.getElementById("loyara-bsave"); btn.disabled=true;
        fetch("/apps/loyalty/birthday",{method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},body:JSON.stringify({birthday:mm+"-"+dd})})
          .then(function(r){return r.json();})
          .then(function(d){ document.getElementById("loyara-b-out").innerHTML='<div class="loyara-msg">'+(d&&d.ok?"Saved — happy early birthday!":"Couldn’t save, try again.")+'</div>'; })
          .catch(function(){ btn.disabled=false; });
      }

      function load(force){
        if (loaded && !force) return;
        fetch("/apps/loyalty/state",{headers:{"Accept":"application/json"}})
          .then(function(r){return r.json();})
          .then(function(d){ state=d; loaded=true; render(); })
          .catch(function(){ content.innerHTML='<div class="loyara-sec"><div class="loyara-msg">Couldn’t load your points.</div></div>'; });
      }

      function setOpen(open){ panel.classList.toggle("open",open); launcher.setAttribute("aria-expanded",open?"true":"false"); if(open){ if(!loaded) load(); closeBtn.focus(); } }
      launcher.addEventListener("click",function(){ setOpen(!panel.classList.contains("open")); });
      closeBtn.addEventListener("click",function(){ setOpen(false); launcher.focus(); });
      document.addEventListener("keydown",function(e){ if(e.key==="Escape"&&panel.classList.contains("open")) setOpen(false); });
      document.addEventListener("click",function(e){ if(panel.classList.contains("open")&&!panel.contains(e.target)&&!launcher.contains(e.target)) setOpen(false); });
      }
      // Defer setup to idle time so the widget never competes with storefront
      // paint (it makes 0 network requests until opened anyway). 2s timeout so it
      // still initialises promptly on a busy main thread.
      if ("requestIdleCallback" in window) requestIdleCallback(init, { timeout: 2000 });
      else setTimeout(init, 1);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Loyara rewards",
  "target": "body",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Show the rewards widget", "default": true },
    { "type": "text", "id": "label", "label": "Button label", "default": "Rewards" },
    {
      "type": "select",
      "id": "preset",
      "label": "Style",
      "options": [
        { "value": "mono", "label": "Minimal (recommended)" },
        { "value": "drawer", "label": "Side drawer" },
        { "value": "hero", "label": "Reward hero" }
      ],
      "default": "mono"
    },
    { "type": "select", "id": "side", "label": "Position", "options": [ { "value": "right", "label": "Bottom right" }, { "value": "left", "label": "Bottom left" } ], "default": "right" },
    { "type": "range", "id": "offset", "label": "Distance from bottom", "min": 8, "max": 140, "step": 4, "unit": "px", "default": 24 },
    { "type": "color", "id": "bg_color", "label": "Accent color", "default": "#1a1a1a" },
    { "type": "color", "id": "text_color", "label": "Text on accent", "default": "#ffffff" }
  ]
}
{% endschema %}
