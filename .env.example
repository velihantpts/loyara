# Copy to .env for local dev. Production values are set in Coolify (never commit
# secrets). The Shopify CLI injects SHOPIFY_API_KEY/SECRET/APP_URL/SCOPES during
# `shopify app dev`, so locally you usually only need DATABASE_URL.

# SQLite file for local dev (resolved relative to prisma/schema.prisma → prisma/dev.sqlite).
DATABASE_URL="file:dev.sqlite"

# --- Set in production (Coolify), required (see scripts/check-env.mjs) ---
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://loyara.velihantoptas.com
# SCOPES=read_orders,read_customers,write_discounts

# --- Optional ---
# RESEND_API_KEY=            # transactional email (points/redeem notifications, monthly summary). No key = no-op.
# EMAIL_FROM=Loyara <onboarding@resend.dev>
# CRON_SECRET=               # guards /cron/* (monthly summary, nightly reconcile, daily birthday/expiry)
# BILLING_TEST=1             # ONLY in a dev/staging deploy — creates TEST charges. Never in prod.
